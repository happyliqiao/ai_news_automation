# ============================================
# AI 新闻自动化 配置文件示例
# 复制本文件为 .env 并填写真实值（.env 已被 git 忽略，不会提交）
# ============================================

# ----- LLM 高质量中文摘要（可选）-----
# 不配置则程序自动使用本地抽取式摘要，功能不受影响
AI_NEWS_API_KEY=
# 兼容 OpenAI 接口的服务商地址，默认 DeepSeek
AI_NEWS_API_BASE=https://api.deepseek.com
# 模型名，DeepSeek 官方对话模型为 deepseek-chat
AI_NEWS_MODEL=deepseek-chat

# ----- 推送渠道（可选，至少配置一个）-----
# 1) Server酱：到 https://sct.ftqq.com/ 用微信扫码登录后获取 SendKey
AI_NEWS_SERVERCHAN_KEY=

# 2) 企业微信群机器人：在企业微信群中添加"群机器人"获取 Webhook 地址
AI_NEWS_WECOM_WEBHOOK=

# 3) 邮件 SMTP（以 QQ 邮箱为例：host=smtp.qq.com，port=465，密码为授权码）
AI_NEWS_SMTP_HOST=
AI_NEWS_SMTP_PORT=465
AI_NEWS_SMTP_USER=
AI_NEWS_SMTP_PASS=
# 收件人，多个用逗号分隔
AI_NEWS_SMTP_TO=
